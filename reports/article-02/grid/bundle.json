  "contract": {
    "version": "evaluator-exploits-v2",
    "question": "Does answer-only search select a configuration that stores unwanted facts or fails separate audit cases?",
    "incumbent": {
      "min_confidence": 0.6,
      "filter_entity": true,
      "time_aware": true,
      "deduplicate": true,
      "top_k": 3
    },
