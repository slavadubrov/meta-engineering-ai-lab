    "max_context_words_per_query": 3,
    "max_p95_scenario_ms": 10,
    "adoption_rule": "Adopt a challenger only if it passes every check and, compared scenario by scenario with the incumbent, it wins at least one scenario and loses none. Otherwise keep the incumbent.",
    "repeats": 5,
    "order_seed": 20260922,
    "exposure": "Original synthetic fixtures written with knowledge of the candidates. Audit cases are withheld from the selector, not from the authors. All cases are public.",
    "budget": "Eight fixed configurations; five fresh-state sweeps each; zero model calls.",
    "adoption": "Local demonstration only; nothing is deployed."
  },
