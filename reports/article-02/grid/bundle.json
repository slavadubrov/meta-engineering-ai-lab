      0.2,
      0.4,
      0.6,
      0.7
    ],
    "top_k": [
      1,
      3
    ],
    "selection": "Maximize development answer success; break ties in declared candidate order. No audit result enters selection.",
    "answer_metric": "A scenario passes on answers when every query answer exactly matches the expected answer.",
    "previous_suite_metric": "Part 1 success: every answer correct and every hard-constraint check passing.",
    "state_requirement": "No write labeled should_retain=false may change memory state.",
    "hard_constraints": [
      "owner_isolation",
      "deletion",
      "prohibited_writes"
